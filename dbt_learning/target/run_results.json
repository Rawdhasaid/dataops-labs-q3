ucts", "compiled": true, "compiled_code": "with products as \n( \n\tselect * from \"ecommerce\".\"STAGE\".\"stg_products\"\n), \n\ndim_products as ( \nselect \n\tproduct_id,\n\tproduct_name,\n\tcategory,\n\tsubcategory, \n\tlist_price - cost_price as unit_margin\n\tfrom products \n\t) \n\tselect * from dim_products", "relation_name": "\"ecommerce\".\"DEV\".\"dim_products\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-04T07:38:14.552272Z", "completed_at": "2026-08-04T07:38:14.582500Z"}, {"name": "execute", "started_at": "2026-08-04T07:38:14.586154Z", "completed_at": "2026-08-04T07:38:14.674291Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.12721967697143555, "adapter_response": {"_message": "SELECT 50", "code": "SELECT", "rows_affected": 50}, "message": "SELECT 50", "failures": null, "unique_id": "model.dbt_learning.dim_customers", "compiled": true, "compiled_code": "with customers as \n( \n\tselect * from \"ecommerce\".\"STAGE\".\"stg_customers\"\n), \n\ndim_customers as ( \nselect \n\tcustomer_id,\n\tTRIM(first_name || ' ' || last_name )AS full_name,\n\temail,\n\tphone, \n\tcountry,\n\tcity,\n\tsignup_date\n\t\n\tfrom customers \n\t) \n\tselect * from dim_customers", "relation_name": "\"ecommerce\".\"DEV\".\"dim_customers\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-04T07:38:14.597734Z", "completed_at": "2026-08-04T07:38:14.610935Z"}, {"name": "execute", "started_at": "2026-08-04T07:38:14.611344Z", "completed_at": "2026-08-04T07:38:14.714479Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.12645506858825684, "adapter_response": {"_message": "SELECT 5", "code": "SELECT", "rows_affected": 5}, "message": "SELECT 5", "failures": null, "unique_id": "model.dbt_learning.example_fct_orders", "compiled": true, "compiled_code": "-- models/dev/example_fct_orders.sql\n-- This is an example fact model to guide you on Task 1.4\n\nwith orders as (\n\n    select * from \"ecommerce\".\"STAGE\".\"example_stg_orders\"\n\n),\n\n-- Example of how you might aggregate or join in the DEV layer\nfinal as (\n\n    select\n        order_status,\n        count(order_id) as total_orders,\n        sum(shipping_fee) as total_shipping_revenue\n\n    from orders\n    group by 1\n\n)\n\nselect * from final", "relation_name": "\"ecommerce\".\"DEV\".\"example_fct_orders\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-04T07:38:14.599850Z", "completed_at": "2026-08-04T07:38:14.619495Z"}, {"name": "execute", "started_at": "2026-08-04T07:38:14.620828Z", "completed_at": "2026-08-04T07:38:14.774476Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.17563915252685547, "adapter_response": {"_message": "INSERT 0 0", "code": "INSERT", "rows_affected": 0}, "message": "INSERT 0 0", "failures": null, "unique_id": "model.dbt_learning.fct_order_items", "compiled": true, "compiled_code": "\n\n\nwith main as (\nSELECT\n    oi.order_item_id,\n    o.customer_id,\n    o.store_id,\n    o.order_date,\n    o.order_status,\n    p.cost_price,\n    cast(oi.quantity * oi.unit_price AS numeric(12,2)) AS gross_amount,\n    cast(oi.quantity * oi.unit_price * oi.discount_pct / 100 AS numeric(12,2)) AS discount_amount,\n    cast(oi.quantity * oi.unit_price * (1 - oi.discount_pct / 100) AS numeric(12,2)) AS net_amount,\n    cast(oi.quantity * p.cost_price AS numeric(12,2)) AS total_cost\n    FROM \"ecommerce\".\"STAGE\".\"stg_order_items\" oi\n    JOIN \"ecommerce\".\"STAGE\".\"stg_orders\" o\n    ON oi.order_id = o.order_id\n    JOIN \"ecommerce\".\"STAGE\".\"stg_products\" p\n    ON oi.product_id = p.product_id\n)\nselect *,\n    net_amount - total_cost AS margin\nfrom main\n\n\n    where order_item_id > (select coalesce(max(order_item_id), 0) from \"ecommerce\".\"DEV\".\"fct_order_items\")\n", "relation_name": "\"ec