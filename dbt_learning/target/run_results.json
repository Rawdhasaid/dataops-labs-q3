{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.0", "generated_at": "2026-08-04T06:35:49.268587Z", "invocation_id": "e78c4082-7699-4dad-870b-0daf978009ea", "invocation_started_at": "2026-08-04T06:35:47.482275Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-08-04T06:35:49.089514Z", "completed_at": "2026-08-04T06:35:49.103592Z"}, {"name": "execute", "started_at": "2026-08-04T06:35:49.104278Z", "completed_at": "2026-08-04T06:35:49.244862Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.15672683715820312, "adapter_response": {"_message": "INSERT 0 0", "code": "INSERT", "rows_affected": 0}, "message": "INSERT 0 0", "failures": null, "unique_id": "model.dbt_learning.fct_order_items", "compiled": true, "compiled_code": "\n\n\nwith main as (\nSELECT\n    oi.order_item_id,\n    o.customer_id,\n    o.store_id,\n    o.order_date,\n    o.order_status,\n    p.cost_price,\n    cast(oi.quantity * oi.unit_price AS numeric(12,2)) AS gross_amount,\n    cast(oi.quantity * oi.unit_price * oi.discount_pct / 100 AS numeric(12,2)) AS discount_amount,\n    cast(oi.quantity * oi.unit_price * (1 - oi.discount_pct / 100) AS numeric(12,2)) AS net_amount,\n    cast(oi.quantity * p.cost_price AS numeric(12,2)) AS total_cost\n    FROM \"ecommerce\".\"STAGE\".\"stg_order_items\" oi\n    JOIN \"ecommerce\".\"STAGE\".\"stg_orders\" o\n    ON oi.order_id = o.order_id\n    JOIN \"ecommerce\".\"STAGE\".\"stg_products\" p\n    ON oi.product_id = p.product_id\n)\nselect *,\n    net_amount - total_cost AS margin\nfrom main\n\n\n    where order_item_id > (select coalesce(max(order_item_id), 0) from \"ecommerce\".\"DEV\".\"fct_order_items\")\n", "relation_name": "\"ecommerce\".\"DEV\".\"fct_order_items\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.4479231834411621, "args": {"warn_error_options": {"error": [], "warn": [], "silence": []}, "use_fast_test_edges"